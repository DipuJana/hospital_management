# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=hospital_db

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/hospital_db?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_root_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret_key